{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && if [ \"$GYMVISUAL_LICENSED\" = \"1\" ]; then node ../scripts/catalogue/stage-media.mjs dist; else echo \"Exercise media left out: set GYMVISUAL_LICENSED=1 once the Gym visual licence for SteelDay is in place\"; fi",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/exercise-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/new_user_identified.fcgi",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/new_user_identified.fcgi"
    },
    {
      "source": "/new_card.fcgi",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/new_card.fcgi"
    },
    {
      "source": "/new_user_id_and_password.fcgi",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/new_user_id_and_password.fcgi"
    },
    {
      "source": "/device_is_alive.fcgi",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/device_is_alive.fcgi"
    },
    {
      "source": "/push",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/push"
    },
    {
      "source": "/result",
      "destination": "https://qyvbwlylalqtvfovczbb.supabase.co/functions/v1/steelday-gestao/result"
    }
  ]
}
